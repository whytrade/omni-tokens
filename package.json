{
  "name": "omni-tokens",
  "version": "0.1.0",
  "description": "From ledger to language: lock any ERC-20, get a capped OpenRouter key, get the change back.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "tab": "./cli/tab.ts"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/main.ts",
    "dev": "node scripts/dev.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "tsc --noEmit",
    "deploy": "node --env-file-if-exists=.env scripts/deploy.ts",
    "tab": "node cli/tab.ts"
  },
  "dependencies": {
    "viem": "^2.31.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2"
  }
}
