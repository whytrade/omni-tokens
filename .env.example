# Chain and escrow (deploy with `npm run deploy`; it prints the two escrow lines).
CHAIN_ID=8453
RPC_URL=https://mainnet.base.org
ESCROW_ADDRESS=
ESCROW_START_BLOCK=
# Blocks to wait before trusting a log.
CONFIRMATIONS=3

# The escrow's operator. Keep a little gas in it: it posts charges and settles tabs.
OPERATOR_PRIVATE_KEY=

# An OpenRouter provisioning key (OpenRouter settings → Provisioning API keys). It can
# create and limit keys, never run inference. Fund the account with credit you are
# willing to front: every open tab reserves its limit against it.
OPENROUTER_PROVISIONING_KEY=

# Tokens this server prices. Each must also be accepted by the escrow (setAccepted).
# price: a USD amount, { "chainlink": "0xFeed" }, or
#        { "uniswapV3": "0xPool", "twapSeconds": 1800, "quote": <price of the pool's other token> }
# floor / ceiling: optional USD bounds; a price outside them refuses new tabs.
TOKENS=[{"address":"0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913","price":"1"}]

# What users pay over provider cost, in basis points: 10000 is cost price, 10500 adds 5%.
# A few percent covers keys that overshoot their limit with parallel requests.
MARKUP_BPS=10500
MIN_TAB_USD=1
MAX_TAB_USD=100
# Credit never handed out, as headroom for bills that land after a key stops.
CREDIT_BUFFER_USD=5

# Shown in the message users sign to claim a key.
PUBLIC_URL=http://localhost:8787
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=data/tab.db

# Optional tuning.
# SETTLE_DELAY_SECONDS=120
# CHARGE_INTERVAL_SECONDS=600
# USAGE_POLL_SECONDS=30
# CORS_ORIGINS=https://your-frontend.example
